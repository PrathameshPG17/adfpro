{
	"name": "Ingestion",
	"properties": {
		"activities": [
			{
				"name": "Read Watermark",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Read watermarks",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from @{pipeline().parameters.schema}.@{pipeline().parameters.table} where ModifiedDate >'@{activity('Read watermarks').output.firstRow.watermark_value}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_database",
						"type": "DatasetReference",
						"parameters": {
							"schema": {
								"value": "@pipeline().parameters.schema",
								"type": "Expression"
							},
							"table": {
								"value": "@pipeline().parameters.table",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_datalake",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.container",
								"type": "Expression"
							},
							"table": {
								"value": "@concat(pipeline().parameters.table,'_',utcNow())",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Execute Pipeline1 - sucess",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Read Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "Email",
						"type": "PipelineReference"
					},
					"waitOnCompletion": false,
					"parameters": {
						"table_name": {
							"value": "@pipeline().parameters.table",
							"type": "Expression"
						},
						"status": "Success",
						"email_recipient": {
							"value": "@pipeline().globalParameters.email",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute Pipeline1_copy1 - fail",
				"type": "ExecutePipeline",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Read Watermark",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "Email",
						"type": "PipelineReference"
					},
					"waitOnCompletion": false,
					"parameters": {
						"table_name": {
							"value": "@pipeline().parameters.table",
							"type": "Expression"
						},
						"status": "Fail",
						"email_recipient": {
							"value": "@pipeline().globalParameters.email",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Read watermarks",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select watermark_value from metadata.table_watermarks where table_name = '@{toLower(pipeline().parameters.table)}';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_database",
						"type": "DatasetReference",
						"parameters": {
							"schema": "testt",
							"table": "resss"
						}
					}
				}
			},
			{
				"name": "update watermark",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Read Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_database",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update metadata.table_watermarks set watermark_value=sysutcdatetime() where table_name = @{toLower(pipeline().parameters.table)}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"schema": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"table": {
				"type": "string",
				"defaultValue": "customers"
			},
			"container": {
				"type": "string",
				"defaultValue": "sink"
			}
		},
		"annotations": []
	}
}